# Freshman Tutorial Platform - backend environment configuration.
# Copy this file to backend/.env and fill in real values, or set them as
# Render environment variables. NEVER commit the real .env file.

# MongoDB Atlas connection string (read/write user on the tutorial DB only).
# Example: mongodb+srv://USER:PASS@cluster.mongodb.net
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net

# Database name inside the Atlas cluster.
DB_NAME=tutorialdb

# Long random string used to sign JWTs (HS256). At least 32 characters.
# Generate one with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-secret-of-at-least-32-characters

# Comma-separated list of allowed frontend origins for CORS.
# Include the Netlify URL plus any local dev origin (e.g. a Live Server port).
FRONTEND_URL=https://freshman-tutorial.netlify.app,http://localhost:5500
