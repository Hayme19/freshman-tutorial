{
    "name": "freshman/tutorial-backend",
    "description": "Freshman Tutorial Platform REST API (PHP 8.2 + MongoDB Atlas).",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "mongodb/mongodb": "^1.17",
        "firebase/php-jwt": "^6.10",
        "vlucas/phpdotenv": "^5.6"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
